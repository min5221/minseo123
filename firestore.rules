rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bookcookie87@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'productName', 'quantity', 'totalAmount', 'recipientName', 'phone', 'address', 'paymentMethod', 'status', 'createdAt'])
        && data.keys().hasOnly(['orderId', 'userId', 'userEmail', 'planId', 'productName', 'quantity', 'unitPrice', 'totalAmount', 'recipientName', 'phone', 'address', 'detailAddress', 'deliveryNote', 'paymentMethod', 'status', 'createdAt'])
        && data.orderId is string && data.orderId.size() <= 64
        && data.productName is string && data.productName.size() <= 100
        && data.quantity is number && data.quantity > 0 && data.quantity <= 100
        && data.totalAmount is number && data.totalAmount > 0
        && data.recipientName is string && data.recipientName.size() > 0 && data.recipientName.size() <= 50
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30
        && data.address is string && data.address.size() > 0 && data.address.size() <= 200
        && (data.paymentMethod == 'card' || data.paymentMethod == 'naver' || data.paymentMethod == 'toss' || data.paymentMethod == 'kakao' || data.paymentMethod == 'transfer' || data.paymentMethod == 'easy')
        && data.status == 'pending'
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /orders/{orderId} {
      // Allow any guest customer or outside visitor to place a real order with strict schema validation
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data) && request.resource.data.orderId == orderId;

      // Allow getting single order (customer lookup or seller inspection)
      allow get: if isValidId(orderId);

      // Allow listing orders so the seller sees incoming orders in real time
      allow list: if true;

      // Allow seller to update order status (e.g. 배송중, 배송완료, 취소)
      allow update: if isValidId(orderId) && request.resource.data.orderId == resource.data.orderId;

      // Allow delete for admin
      allow delete: if isAdmin();
    }
  }
}
